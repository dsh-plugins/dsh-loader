{
  "name": "@dsh-external/example-plugin",
  "version": "1.0.0",
  "description": "Example dsh plugin showing how to program against dshloader's stable API instead of dsh internals.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "peerDependencies": {
    "@dsh-external/dshloader": "^1.0.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": false }
  },
  "license": "BSD-3-Clause"
}
